[Unit]
Description=Keyboard mouse mode for Wayland
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/keyboard-mouse/keyboard_mouse_wayland.py
WorkingDirectory=%h/.local/share/keyboard-mouse
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
